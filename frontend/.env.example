# ==============================================================================
# INCIDENT INVESTIGATOR FRONTEND - ENVIRONMENT TEMPLATE
# Copy to frontend/.env.local and customize as needed.
# ==============================================================================

# Next.js Server Port (default 3000, secondary 3002)
PORT=3000

# Backend Express API Public URL (Accessible from client browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Internal Backend URL (Used by Next.js server rewrites)
BACKEND_URL=http://localhost:3001

# Application Branding & Display Title
NEXT_PUBLIC_APP_NAME="Incident AI - Production Investigator"

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
