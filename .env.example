# Copy this file to .env for local development. Never commit real credentials.

FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000,http://localhost:3002
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
API_URL=http://localhost:3001/api
NODE_ENV=development

POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=incident_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incident_user:change-me@localhost:5432/incident_db
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Set these in the deployment secret manager or in an ignored local .env file.
OPENAI_API_KEY=
JWT_SECRET=
SESSION_SECRET=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
PAGERDUTY_ROUTING_KEY=

OTEL_SERVICE_NAME=incident-investigator
OTEL_EXPORTER_PROMETHEUS_PORT=9464
